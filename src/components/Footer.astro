---
const today = new Date();
---

<footer>
	<div class="business-info">
		<strong>Jorge Benavides Aspiazu</strong>
		<span>jobenas — IoT & Connected Systems Consulting</span>
		<span>Lima, Peru &middot; me@jobenas.com</span>
	</div>
	<div class="newsletter-footer">
		<form
			action="https://buttondown.com/api/emails/embed-subscribe/jobenas"
			method="post"
			target="popupwindow"
			class="embeddable-buttondown-form"
		>
			<input type="email" name="email" placeholder="your@email.com" required />
			<input type="submit" value="Subscribe" />
		</form>
	</div>
	<div class="social-links">
		<a href="https://www.linkedin.com/in/jorge-benavides-aspiazu-190a28b/" target="_blank">
			<span class="sr-only">Jorge on LinkedIn</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
				><path
					fill="currentColor"
					d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
				></path></svg
			>
		</a>
	</div>
	<div class="copyright">
		&copy; {today.getFullYear()} Jorge Benavides Aspiazu. All rights reserved.
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.business-info {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		margin-bottom: 1.5em;
		font-size: 0.9em;
	}
	.business-info strong {
		color: rgb(var(--gray-dark));
		font-size: 1.05em;
	}
	.newsletter-footer {
		margin-bottom: 1.25em;
	}
	.newsletter-footer form {
		display: flex;
		justify-content: center;
		gap: 0.5em;
	}
	.newsletter-footer input[type="email"] {
		padding: 0.4em 0.75em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		font-size: 0.85em;
		width: 200px;
	}
	.newsletter-footer input[type="submit"] {
		padding: 0.4em 1em;
		background: var(--accent);
		color: white;
		border: none;
		border-radius: 6px;
		font-weight: 700;
		cursor: pointer;
		font-size: 0.85em;
	}
	.newsletter-footer input[type="submit"]:hover {
		background: var(--accent-dark);
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-bottom: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.copyright {
		font-size: 0.85em;
	}
</style>
